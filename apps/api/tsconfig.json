{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2021",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@komunaid/shared": ["../../packages/shared/src"],
      "@komunaid/shared/*": ["../../packages/shared/src/*"],
      "@komunaid/database": ["../../packages/database/src"],
      "@komunaid/database/*": ["../../packages/database/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/**/*.spec.ts"]
}
