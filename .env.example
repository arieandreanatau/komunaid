# Environment Variables - KomunaID
# Copy this file to .env and fill in the values

# ============================================
# APP
# ============================================
NODE_ENV=development
APP_NAME=KomunaID
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
APP_PORT=3000
API_PORT=4000

# ============================================
# DATABASE
# ============================================
DATABASE_URL="mysql://root:password@localhost:3306/komunaid"

# ============================================
# AUTH
# ============================================
JWT_SECRET=change-me-to-a-secure-random-string
JWT_EXPIRES_IN=15m
PASSWORD_RESET_SECRET=change-me-to-a-separate-random-string
REFRESH_TOKEN_SECRET=change-me-to-another-secure-random-string
REFRESH_TOKEN_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# ============================================
# EMAIL (SMTP)
# ============================================
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="KomunaID <noreply@komuna.id>"

# ============================================
# FILE STORAGE (S3-compatible)
# ============================================
S3_ENDPOINT=
S3_BUCKET=komunaid
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_PUBLIC_URL=

# ============================================
# FRONTEND (used by API for links in emails, etc.)
# ============================================
FRONTEND_URL=http://localhost:3000

# ============================================
# CORS
# ============================================
CORS_ORIGIN=http://localhost:3000
