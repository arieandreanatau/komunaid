# KomunaID Environment Variables
# Copy this file to .env.development or .env.production
# NEVER commit actual .env files to version control

# ==========================================
# DATABASE
# ==========================================
DATABASE_URL="mysql://root:password@localhost:3306/komunaid_dev"

# ==========================================
# AUTH
# ==========================================
JWT_SECRET="your-super-secret-jwt-key-min-64-chars"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="30d"

# ==========================================
# COOKIE
# ==========================================
COOKIE_SECRET="your-cookie-secret-min-64-chars"
COOKIE_DOMAIN="localhost"

# ==========================================
# BCRYPT
# ==========================================
BCRYPT_ROUNDS=12

# ==========================================
# API
# ==========================================
API_PORT=3001
API_URL="http://localhost:3001"
CORS_ORIGIN="http://localhost:3000"

# ==========================================
# FRONTEND
# ==========================================
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="KomunaID"

# ==========================================
# STORAGE (S3-compatible)
# ==========================================
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION=""

# ==========================================
# EMAIL
# ==========================================
# Preferred: Resend (https://resend.com, free tier; quota follows current plan)
RESEND_API_KEY=""
# Production sender domain must be verified in Resend or SMTP provider.
EMAIL_FROM="KomunaID <noreply@komuna.id>"

# Fallback: SMTP (used if RESEND_API_KEY is empty)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE=false
APP_URL="http://localhost:3000"

# ==========================================
# REDIS (Optional, for production rate limiting)
# ==========================================
REDIS_URL=""
REDIS_CONNECT_TIMEOUT=5000
REDIS_KEY_PREFIX="komunaid:"
TRUSTED_PROXIES="false"

# ==========================================
# RATE LIMITING
# ==========================================
# Login
LOGIN_RATE_WINDOW_MS=900000
LOGIN_RATE_MAX=5
# Forgot Password
FORGOT_PASSWORD_RATE_WINDOW_MS=3600000
FORGOT_PASSWORD_RATE_MAX=3
# Reset Password
RESET_PASSWORD_RATE_WINDOW_MS=3600000
RESET_PASSWORD_RATE_MAX=5
# Refresh Token
REFRESH_TOKEN_RATE_WINDOW_MS=900000
REFRESH_TOKEN_RATE_MAX=10
# General API
API_RATE_WINDOW_MS=900000
API_RATE_MAX=100
# Admin Mutations
ADMIN_MUTATION_RATE_WINDOW_MS=60000
ADMIN_MUTATION_RATE_MAX=30
# Registration
REGISTRATION_RATE_WINDOW_MS=3600000
REGISTRATION_RATE_MAX=5
# Contact Form
CONTACT_FORM_RATE_WINDOW_MS=3600000
CONTACT_FORM_RATE_MAX=3

# ==========================================
# REFRESH TOKEN
# ==========================================
REFRESH_TOKEN_EXPIRY_DAYS=30
REFRESH_TOKEN_FAMILY_LIMIT=10

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL="debug"

# ==========================================
# APP
# ==========================================
NODE_ENV="development"
APP_NAME="KomunaID"

# ==========================================
# FEATURE FLAGS (Dormant Modules)
# Organization is in-scope V1 (canonical §5.1) -> enabled by default.
# Brand/Campaign/Collab/Partnership/etc are dormant V1 -> false.
# Set to "true" to enable a module in future phases
# ==========================================
NEXT_PUBLIC_ORGANIZATION_ENABLED=true
NEXT_PUBLIC_BRAND_ENABLED=false
NEXT_PUBLIC_CAMPAIGN_ENABLED=false
NEXT_PUBLIC_COLLABORATION_ENABLED=false
NEXT_PUBLIC_PARTNERSHIP_ENABLED=false
NEXT_PUBLIC_CSR_ENABLED=false
NEXT_PUBLIC_MARKETPLACE_ENABLED=false
NEXT_PUBLIC_FINANCE_ENABLED=false
NEXT_PUBLIC_WALLET_ENABLED=false
NEXT_PUBLIC_DONATION_ENABLED=false
NEXT_PUBLIC_CHAT_ENABLED=false
NEXT_PUBLIC_SOCIAL_FEED_ENABLED=false
NEXT_PUBLIC_GAMIFICATION_ENABLED=false

# Backend feature flags (without NEXT_PUBLIC_ prefix, used server-side)
ORGANIZATION_ENABLED=true
BRAND_ENABLED=false
CAMPAIGN_ENABLED=false
COLLABORATION_ENABLED=false
PARTNERSHIP_ENABLED=false
CSR_ENABLED=false
MARKETPLACE_ENABLED=false
FINANCE_ENABLED=false
WALLET_ENABLED=false
DONATION_ENABLED=false
CHAT_ENABLED=false
SOCIAL_FEED_ENABLED=false
GAMIFICATION_ENABLED=false
