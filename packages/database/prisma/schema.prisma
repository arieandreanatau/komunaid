generator client {
  provider      = "prisma-client-js"
  engineType    = "library"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "darwin", "windows"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// USER & AUTH
// ==========================================

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  username        String     @unique
  password        String
  name            String
  avatar          String?
  phone           String?
  bio             String?    @db.Text
  location        String?
  emailVerifiedAt DateTime?
  status          UserStatus @default(ACTIVE)
  deletedAt       DateTime?
  tokenVersion    Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Relations
  roles                 UserRole[]
  interests             UserInterest[]
  joinedCommunities     CommunityMember[]
  organizationMembers   OrganizationMember[]
  registeredEvents      EventRegistration[]
  savedEvents           EventSave[]
  createdCommunities    Community[]
  createdOrganizations  Organization[]
  createdEvents         Event[]
  auditLogs             AuditLog[]
  reportedReports       Report[]               @relation("ReportReporter")
  reviewedReports       Report[]               @relation("ReportReviewer")
  joinRequests          JoinRequest[]
  notifications         Notification[]
  activityLogs          ActivityHistory[]
  membershipHistory     MembershipHistory[]
  createdVolunteerOpps  VolunteerOpportunity[]
  volunteerApplications VolunteerApplication[]
  reviewedVolunteerApps VolunteerApplication[] @relation("ReviewedVolunteerApps")
  picAssignments        VolunteerAssignment[]
  communityMedias       CommunityMedia[]
  forumReplies          ForumReply[]
  loginHistory          LoginHistory[]
  refreshTokens         RefreshToken[]

  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model UserRole {
  id        String       @id @default(cuid())
  userId    String
  role      PlatformRole
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_roles")
}

enum PlatformRole {
  SUPER_ADMIN
  PLATFORM_ADMIN
  MEMBER
}

// ==========================================
// COMMUNITY
// ==========================================

model Community {
  id             String              @id @default(cuid())
  name           String
  slug           String              @unique
  description    String?             @db.Text
  coverImage     String?
  logo           String?
  location       String?
  website        String?
  membershipType MembershipType      @default(OPEN)
  status         CommunityStatus     @default(PENDING)
  visibility     CommunityVisibility @default(PUBLIC)
  banner         String?
  address        String?
  address1       String?
  address2       String?
  postalCode     String?
  district       String?
  village        String?             @map("kelurahan")
  country        String?
  province       String?
  city           String?
  instagram      String?
  contactEmail   String?
  contactPhone   String?
  adminNote      String?             @db.Text
  submittedAt    DateTime?
  reviewedAt     DateTime?
  deletedAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  // Relations
  ownerId             String
  owner               User                 @relation(fields: [ownerId], references: [id])
  members             CommunityMember[]
  events              Event[]
  categories          CommunityCategory[]
  joinRequests        JoinRequest[]
  tags                CommunityTag[]
  settings            CommunitySettings?
  media               CommunityMedia[]
  statistics          CommunityStatistic[]
  membershipHistories MembershipHistory[]

  @@index([ownerId])
  @@index([status])
  @@index([submittedAt])
  @@index([deletedAt])
  @@map("communities")
}

enum MembershipType {
  OPEN
  RESTRICTED
}

enum CommunityVisibility {
  PUBLIC
  PRIVATE
}

enum CommunityStatus {
  DRAFT
  PENDING
  APPROVED
  SUSPENDED
  ARCHIVED
  REJECTED
  REVISION_REQUIRED
}

model CommunityMember {
  id          String           @id @default(cuid())
  communityId String
  userId      String
  role        CommunityRole    @default(MEMBER)
  status      MembershipStatus @default(ACTIVE)
  joinedAt    DateTime         @default(now())
  deletedAt   DateTime?

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([communityId])
  @@index([userId])
  @@index([deletedAt])
  @@index([communityId, status])
  @@map("community_members")
}

enum CommunityRole {
  OWNER
  ADMIN
  EVENT_MANAGER
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  PENDING
  REJECTED
  BANNED
}

// NOTE: The @@unique constraints below do not fully prevent duplicate join requests
// when communityId or organizationId is NULL, because MySQL treats NULL != NULL in
// unique indexes. Duplicate check MUST be done at the application level before insert.
model JoinRequest {
  id             String            @id @default(cuid())
  communityId    String?
  organizationId String?
  userId         String
  status         JoinRequestStatus @default(PENDING)
  message        String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  community    Community?    @relation(fields: [communityId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@unique([organizationId, userId])
  @@index([communityId])
  @@index([organizationId])
  @@index([userId])
  @@map("join_requests")
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model CommunityCategory {
  id          String   @id @default(cuid())
  communityId String
  categoryId  String
  createdAt   DateTime @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([communityId, categoryId])
  @@index([categoryId])
  @@map("community_categories")
}

// ==========================================
// COMMUNITY TAGS
// ==========================================

model CommunityTag {
  id          String   @id @default(cuid())
  communityId String
  tag         String
  createdAt   DateTime @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([communityId, tag])
  @@index([communityId])
  @@index([tag])
  @@map("community_tags")
}

model CommunitySettings {
  id              String   @id @default(cuid())
  communityId     String   @unique
  allowMemberPost Boolean  @default(true)
  requireApproval Boolean  @default(false)
  showMemberList  Boolean  @default(true)
  showEventList   Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@map("community_settings")
}

// ==========================================
// COMMUNITY MEDIA (Announcements & News)
// ==========================================

enum CommunityMediaType {
  ANNOUNCEMENT
  NEWS
  GALLERY
  FORUM_POST
}

model ForumReply {
  id          String   @id @default(cuid())
  threadId    String
  content     String   @db.Text
  createdById String
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  thread    CommunityMedia @relation(fields: [threadId], references: [id], onDelete: Cascade)
  createdBy User           @relation(fields: [createdById], references: [id])

  @@index([threadId])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("forum_replies")
}

model CommunityMedia {
  id          String             @id @default(cuid())
  communityId String
  title       String
  content     String             @db.Text
  type        CommunityMediaType @default(ANNOUNCEMENT)
  imageUrl    String?
  isPublished Boolean            @default(false)
  publishedAt DateTime?
  createdById String
  deletedAt   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  community  Community     @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy  User          @relation(fields: [createdById], references: [id])
  replies    ForumReply[]

  @@index([communityId])
  @@index([type])
  @@index([isPublished])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("community_media")
}

// ==========================================
// COMMUNITY STATISTICS
// ==========================================

model CommunityStatistic {
  id              String   @id @default(cuid())
  communityId     String
  totalMembers    Int      @default(0)
  totalEvents     Int      @default(0)
  totalVolunteers Int      @default(0)
  snapshotDate    DateTime @default(now())
  metadata        Json?
  createdAt       DateTime @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@index([communityId])
  @@index([snapshotDate])
  @@map("community_statistics")
}

// ==========================================
// ORGANIZATION
// ==========================================

model Organization {
  id           String                 @id @default(cuid())
  name         String
  slug         String                 @unique
  description  String?                @db.Text
  logo         String?
  banner       String?
  website      String?
  location     String?
  industry     String?
  address      String?
  address1     String?
  address2     String?
  postalCode   String?
  kelurahan    String?
  district     String?
  country      String?
  province     String?
  city         String?
  instagram    String?
  contactEmail String?
  contactPhone String?
  visibility   OrganizationVisibility @default(PUBLIC)
  status       OrganizationStatus     @default(DRAFT)
  adminNote    String?                @db.Text
  submittedAt  DateTime?
  reviewedAt   DateTime?
  deletedAt    DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  ownerId             String
  owner               User                   @relation(fields: [ownerId], references: [id])
  members             OrganizationMember[]
  events              Event[]
  categories          OrganizationCategory[]
  tags                OrganizationTag[]
  settings            OrganizationSettings?
  membershipHistories MembershipHistory[]
  joinRequests        JoinRequest[]

  @@index([ownerId])
  @@index([status])
  @@index([submittedAt])
  @@index([deletedAt])
  @@map("organizations")
}

enum OrganizationVisibility {
  PUBLIC
  PRIVATE
}

enum OrganizationStatus {
  DRAFT
  PENDING
  APPROVED
  SUSPENDED
  ARCHIVED
  REJECTED
  REVISION_REQUIRED
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(MEMBER)
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now())
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([deletedAt])
  @@index([organizationId, status])
  @@map("organization_members")
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

model OrganizationCategory {
  id             String   @id @default(cuid())
  organizationId String
  categoryId     String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([organizationId, categoryId])
  @@index([categoryId])
  @@map("organization_categories")
}

model OrganizationTag {
  id             String   @id @default(cuid())
  organizationId String
  tag            String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, tag])
  @@index([organizationId])
  @@index([tag])
  @@map("organization_tags")
}

model OrganizationSettings {
  id              String   @id @default(cuid())
  organizationId  String   @unique
  allowMemberPost Boolean  @default(true)
  requireApproval Boolean  @default(false)
  showMemberList  Boolean  @default(true)
  showEventList   Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

// ==========================================
// EVENT
// ==========================================

model Event {
  id            String          @id @default(cuid())
  title         String
  slug          String          @unique
  description   String?         @db.Text
  coverImage    String?
  thumbnail     String?
  location      String?
  locationType  LocationType    @default(OFFLINE)
  isOnline      Boolean         @default(false)
  onlineUrl     String?
  meetingUrl    String?
  eventDate     DateTime
  endDate       DateTime?
  timezone      String?         @default("Asia/Jakarta")
  quota         Int
  allowWaitlist Boolean         @default(false)
  status        EventStatus     @default(DRAFT)
  visibility    EventVisibility @default(PUBLIC)
  contactName   String?
  contactEmail  String?
  contactPhone  String?
  gallery       String?         @db.Text
  deletedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  communityId    String?
  organizationId String?
  createdById    String

  community              Community?             @relation(fields: [communityId], references: [id], onDelete: SetNull)
  organization           Organization?          @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdBy              User                   @relation(fields: [createdById], references: [id])
  registrations          EventRegistration[]
  savedBy                EventSave[]
  categories             EventCategory[]
  volunteerOpportunities VolunteerOpportunity[]

  @@index([communityId])
  @@index([organizationId])
  @@index([createdById])
  @@index([eventDate])
  @@index([status])
  @@index([deletedAt])
  @@index([communityId, status, eventDate])
  @@index([organizationId, status, eventDate])
  @@map("events")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  ONGOING
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum EventVisibility {
  PUBLIC
  PRIVATE
}

enum LocationType {
  OFFLINE
  ONLINE
  HYBRID
}

model EventRegistration {
  id           String             @id @default(cuid())
  eventId      String
  userId       String
  status       RegistrationStatus @default(CONFIRMED)
  attendance   AttendanceStatus   @default(NOT_CHECKED_IN)
  checkedInAt  DateTime?
  checkedOutAt DateTime?
  notes        String?
  registeredAt DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@index([attendance])
  @@index([eventId, status])
  @@map("event_registrations")
}

model EventSave {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId, createdAt])
  @@map("event_saves")
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  WAITLISTED
  REJECTED
}

enum AttendanceStatus {
  NOT_CHECKED_IN
  CHECKED_IN
  CHECKED_OUT
}

model EventCategory {
  id         String   @id @default(cuid())
  eventId    String
  categoryId String
  createdAt  DateTime @default(now())

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([eventId, categoryId])
  @@index([categoryId])
  @@map("event_categories")
}

// ==========================================
// VOLUNTEER
// ==========================================

model VolunteerOpportunity {
  id                   String                     @id @default(cuid())
  title                String
  slug                 String                     @unique
  description          String?                    @db.Text
  status               VolunteerOpportunityStatus @default(DRAFT)
  registrationDeadline DateTime?
  briefingDate         DateTime?
  activityStartDate    DateTime?
  activityEndDate      DateTime?
  deletedAt            DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  eventId     String
  createdById String

  event        Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy    User                   @relation(fields: [createdById], references: [id])
  positions    VolunteerPosition[]
  applications VolunteerApplication[]

  @@index([eventId])
  @@index([createdById])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("volunteer_opportunities")
}

enum VolunteerOpportunityStatus {
  DRAFT
  PUBLISHED
  OPEN
  CLOSED
  ARCHIVED
}

model VolunteerPosition {
  id            String   @id @default(cuid())
  opportunityId String
  name          String
  description   String?  @db.Text
  requiredQty   Int      @default(1)
  requirement   String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  opportunity  VolunteerOpportunity   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  assignments  VolunteerAssignment[]
  applications VolunteerApplication[]

  @@index([opportunityId])
  @@map("volunteer_positions")
}

model VolunteerApplication {
  id            String                     @id @default(cuid())
  opportunityId String
  positionId    String
  userId        String
  motivation    String?                    @db.Text
  experience    String?                    @db.Text
  availability  String?                    @db.Text
  agreement     Boolean                    @default(false)
  status        VolunteerApplicationStatus @default(APPLIED)
  reviewedAt    DateTime?
  reviewedById  String?
  reviewNote    String?                    @db.Text
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  opportunity VolunteerOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  position    VolunteerPosition    @relation(fields: [positionId], references: [id], onDelete: Cascade)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy  User?                @relation("ReviewedVolunteerApps", fields: [reviewedById], references: [id])
  assignment  VolunteerAssignment?

  @@unique([opportunityId, userId])
  @@index([opportunityId])
  @@index([positionId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("volunteer_applications")
}

enum VolunteerApplicationStatus {
  APPLIED
  REVIEWED
  ACCEPTED
  REJECTED
}

model VolunteerAssignment {
  id            String    @id @default(cuid())
  applicationId String    @unique
  positionId    String
  picUserId     String?
  shiftStart    DateTime?
  shiftEnd      DateTime?
  notes         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  application VolunteerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  position    VolunteerPosition    @relation(fields: [positionId], references: [id], onDelete: Cascade)
  picUser     User?                @relation(fields: [picUserId], references: [id])
  attendance  VolunteerAttendance?

  @@index([positionId])
  @@index([picUserId])
  @@index([applicationId])
  @@map("volunteer_assignments")
}

model VolunteerAttendance {
  id           String           @id @default(cuid())
  assignmentId String           @unique
  checkInAt    DateTime?
  checkOutAt   DateTime?
  status       AttendanceStatus @default(NOT_CHECKED_IN)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  assignment VolunteerAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([status])
  @@map("volunteer_attendances")
}

// ==========================================
// CATEGORY
// ==========================================

enum CategoryType {
  COMMUNITY
  ORGANIZATION
  EVENT
  VOLUNTEER
}

model Category {
  id          String       @id @default(cuid())
  name        String       @unique
  slug        String       @unique
  description String?      @db.Text
  icon        String?
  type        CategoryType @default(COMMUNITY)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  communities   CommunityCategory[]
  organizations OrganizationCategory[]
  events        EventCategory[]

  @@index([type])
  @@index([isActive])
  @@map("categories")
}

// ==========================================
// REPORT & MODERATION (polymorphic: targetType + targetId)
// ==========================================

model Report {
  id          String           @id @default(cuid())
  reporterId  String
  targetType  ReportTargetType
  targetId    String
  reason      ReportReason
  description String?          @db.Text
  status      ReportStatus     @default(OPEN)
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNote  String?          @db.Text
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  reporter User  @relation("ReportReporter", fields: [reporterId], references: [id])
  reviewer User? @relation("ReportReviewer", fields: [reviewedBy], references: [id])

  @@index([status])
  @@index([reporterId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("reports")
}

enum ReportTargetType {
  COMMUNITY
  EVENT
  USER
  ORGANIZATION
}

enum ReportReason {
  SPAM
  HARASSMENT
  INAPPROPRIATE_CONTENT
  MISINFORMATION
  COPYRIGHT_VIOLATION
  OTHER
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  DISMISSED
  SUSPENDED
}

// ==========================================
// AUDIT LOG
// ==========================================

model AuditLog {
  id           String   @id @default(cuid())
  userId       String
  actionType   String
  resourceName String
  resourceId   String
  beforeData   Json?
  afterData    Json?
  ipAddress    String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([resourceName, resourceId])
  @@index([actionType])
  @@index([createdAt])
  @@map("audit_logs")
}

// ==========================================
// NOTIFICATION
// ==========================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

enum NotificationType {
  SYSTEM
  COMMUNITY
  ORGANIZATION
  EVENT
  REPORT
  APPROVAL
}

model NotificationTemplate {
  id        String           @id @default(cuid())
  name      String           @unique
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([isActive])
  @@map("notification_templates")
}

// ==========================================
// MEMBERSHIP HISTORY
// ==========================================

model MembershipHistory {
  id             String           @id @default(cuid())
  communityId    String?
  organizationId String?
  userId         String
  action         MembershipAction
  oldRole        String?
  newRole        String?
  details        Json?
  performedBy    String?
  createdAt      DateTime         @default(now())

  community    Community?    @relation(fields: [communityId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id])

  @@index([communityId])
  @@index([organizationId])
  @@index([userId])
  @@index([createdAt])
  @@map("membership_history")
}

enum MembershipAction {
  COMMUNITY_CREATED
  COMMUNITY_APPROVED
  COMMUNITY_SUSPENDED
  COMMUNITY_REJECTED
  COMMUNITY_REVISION_REQUESTED
  COMMUNITY_RESTORED
  COMMUNITY_MEMBER_JOIN
  COMMUNITY_MEMBER_LEAVE
  COMMUNITY_MEMBER_REMOVE
  COMMUNITY_ROLE_CHANGE
  ORG_CREATED
  ORG_APPROVED
  ORG_SUSPENDED
  ORG_REJECTED
  ORG_REVISION_REQUESTED
  ORG_RESTORED
  ORG_MEMBER_JOIN
  ORG_MEMBER_LEAVE
  ORG_MEMBER_REMOVE
  ORG_ROLE_CHANGE
}

enum MessageCategory {
  GENERAL
  FEEDBACK
  COMPLAINT
  SUGGESTION
  PARTNERSHIP
  OTHER
}

enum MessageStatus {
  PENDING
  READ
  REPLIED
  ARCHIVED
}

// ==========================================
// INTEREST
// ==========================================

model UserInterest {
  id        String   @id @default(cuid())
  userId    String
  interest  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, interest])
  @@map("user_interests")
}

// ==========================================
// ACTIVITY HISTORY
// ==========================================

model ActivityHistory {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("activity_history")
}

// ==========================================
// LOGIN HISTORY
// ==========================================

model LoginHistory {
  id            String   @id @default(cuid())
  userId        String
  ipAddress     String?
  userAgent     String?
  success       Boolean  @default(true)
  failureReason String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([success])
  @@map("login_history")
}

// ==========================================
// CMS PAGES
// ==========================================

model CmsPage {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  content     String    @db.LongText
  metaTitle   String?
  metaDesc    String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([isPublished])
  @@map("cms_pages")
}

// ==========================================
// CMS BANNERS
// ==========================================

model CmsBanner {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String
  linkUrl   String?
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([position])
  @@map("cms_banners")
}

// ==========================================
// CMS CONTACT
// ==========================================

model CmsContact {
  id          String   @id @default(cuid())
  companyName String
  phone       String?
  address     String?  @db.Text
  email       String?
  instagram   String?
  facebook    String?
  twitter     String?
  threads     String?
  website     String?
  mapsUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("cms_contacts")
}

// ==========================================
// SETTINGS
// ==========================================

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ==========================================
// ORGANIZATION STRUCTURE (PT Komuna Digital Indonesia)
// ==========================================

model OrganizationStructure {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  imageUrl    String?
  parentId    String?
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent                       OrganizationStructure?        @relation("OrgStructHierarchy", fields: [parentId], references: [id])
  children                     OrganizationStructure[]       @relation("OrgStructHierarchy")
  organizationStructureMembers OrganizationStructureMember[]

  @@index([parentId])
  @@index([position])
  @@index([isActive])
  @@map("organization_structures")
}

model OrganizationStructureMember {
  id          String   @id @default(cuid())
  structureId String
  name        String
  position    String
  email       String?
  phone       String?
  avatar      String?
  bio         String?  @db.Text
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  structure OrganizationStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)

  @@index([structureId])
  @@index([order])
  @@map("organization_structure_members")
}

// ==========================================
// CONTACT MESSAGES (Guest Submit)
// ==========================================

model ContactMessage {
  id        String          @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String          @db.Text
  category  MessageCategory @default(GENERAL)
  status    MessageStatus   @default(PENDING)
  reply     String?         @db.Text
  repliedAt DateTime?
  repliedBy String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("contact_messages")
}

// ==========================================
// REFRESH TOKEN (Rotation + Family Tracking)
// ==========================================

model RefreshToken {
  id           String   @id @default(cuid())
  userId       String
  tokenHash    String   @unique
  familyId     String
  fingerprint  String?
  ipAddress    String?
  userAgent    String?
  isRevoked    Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@index([userId, isRevoked])
  @@map("refresh_tokens")
}
