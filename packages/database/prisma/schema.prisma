generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & AUTH
// ============================================

model User {
  id              String    @id @default(uuid()) @db.VarChar(36)
  email           String    @unique @db.VarChar(255)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  firstName       String    @map("first_name") @db.VarChar(100)
  lastName        String    @map("last_name") @db.VarChar(100)
  username        String    @unique @db.VarChar(30)
  avatar          String?   @db.VarChar(500)
  bio             String?   @db.Text
  location        String?   @db.VarChar(200)
  phone           String?   @db.VarChar(20)
  emailVerified   Boolean   @default(false) @map("email_verified")
  isActive        Boolean   @default(true) @map("is_active")
  isSuspended     Boolean   @default(false) @map("is_suspended")
  suspendedAt     DateTime? @map("suspended_at")
  suspendedReason String?   @map("suspended_reason") @db.VarChar(500)
  lastLoginAt     DateTime? @map("last_login_at")
  interests       String?   @db.Text // JSON array of interest IDs
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  // Relations
  roles                UserRoleAssignment[]
  communityMemberships  CommunityMember[]
  ownedCommunities     Community[]           @relation("CommunityOwner")
  organizationMembers  OrganizationMember[]
  ownedOrganizations   Organization[]        @relation("OrgOwner")
  eventRegistrations   EventRegistration[]
  createdEvents        Event[]               @relation("EventCreator")
  posts                Post[]                @relation("PostAuthor")
  reports              Report[]              @relation("ReportReporter")
  resolvedReports      Report[]              @relation("ReportResolver")
  notifications        Notification[]
  auditLogs            AuditLog[]
  communityApproved    Community[]           @relation("CommunityApprover")
  communityRejected    Community[]           @relation("CommunityRejection")
  organizationApproved Organization[]        @relation("OrgApprover")
  eventApproved        Event[]               @relation("EventApprover")
  roleUpgradeRequests  RoleUpgradeRequest[] @relation("UpgradeRequestUser")
  reviewedUpgradeRequests RoleUpgradeRequest[] @relation("UpgradeReviewer")
  mediaAssets          MediaAsset[]

  @@index([email])
  @@index([username])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id        String   @id @default(uuid()) @db.VarChar(36)
  name      String   @unique @db.VarChar(50)
  description String? @db.VarChar(255)
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  userAssignments UserRoleAssignment[]
  upgradeRequests RoleUpgradeRequest[]

  @@map("roles")
}

model UserRoleAssignment {
  id         String    @id @default(uuid()) @db.VarChar(36)
  userId     String    @map("user_id") @db.VarChar(36)
  roleId     String    @map("role_id") @db.VarChar(36)
  grantedById String?  @map("granted_by_id") @db.VarChar(36)
  grantedAt  DateTime  @default(now()) @map("granted_at")
  scope      String?   @db.VarChar(50) // COMMUNITY, ORGANIZATION, PLATFORM
  scopeId    String?   @map("scope_id") @db.VarChar(36)
  createdAt  DateTime  @default(now()) @map("created_at")

  // Relations
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, scope, scopeId])
  @@index([userId])
  @@index([roleId])
  @@map("user_role_assignments")
}

model RoleUpgradeRequest {
  id              String   @id @default(uuid()) @db.VarChar(36)
  userId          String   @map("user_id") @db.VarChar(36)
  requestedRoleId String   @map("requested_role_id") @db.VarChar(36)
  reason          String   @db.Text
  status          String   @default("PENDING") @db.VarChar(20)
  reviewedById    String?  @map("reviewed_by_id") @db.VarChar(36)
  reviewedAt      DateTime? @map("reviewed_at")
  reviewNote      String?  @map("review_note") @db.VarChar(500)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user          User  @relation("UpgradeRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  requestedRole Role  @relation(fields: [requestedRoleId], references: [id])
  reviewer      User? @relation("UpgradeReviewer", fields: [reviewedById], references: [id])

  @@index([userId])
  @@index([status])
  @@map("role_upgrade_requests")
}

// ============================================
// COMMUNITY
// ============================================

model Community {
  id              String    @id @default(uuid()) @db.VarChar(36)
  name            String    @db.VarChar(200)
  slug            String    @unique @db.VarChar(200)
  description     String    @db.Text
  shortDescription String?  @map("short_description") @db.VarChar(300)
  logo            String?   @db.VarChar(500)
  banner          String?   @db.VarChar(500)
  category        String    @db.VarChar(100)
  location        String?   @db.VarChar(200)
  website         String?   @db.VarChar(500)
  contactEmail    String?   @map("contact_email") @db.VarChar(255)
  contactPhone    String?   @map("contact_phone") @db.VarChar(20)
  foundedAt       DateTime? @map("founded_at")
  membershipType  String    @default("OPEN") @map("membership_type") @db.VarChar(20)
  maxMembers      Int?      @map("max_members")
  isVerified      Boolean   @default(false) @map("is_verified")
  status          String    @default("PENDING") @db.VarChar(20)
  statusReason    String?   @map("status_reason") @db.VarChar(500)
  approvedAt      DateTime? @map("approved_at")
  approvedById    String?   @map("approved_by_id") @db.VarChar(36)
  rejectedAt      DateTime? @map("rejected_at")
  rejectedById    String?   @map("rejected_by_id") @db.VarChar(36)
  suspendedAt     DateTime? @map("suspended_at")
  suspendedReason String?   @map("suspended_reason") @db.VarChar(500)
  ownerId         String    @map("owner_id") @db.VarChar(36)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  // Relations
  owner          User              @relation("CommunityOwner", fields: [ownerId], references: [id])
  approver       User?             @relation("CommunityApprover", fields: [approvedById], references: [id])
  rejector       User?             @relation("CommunityRejection", fields: [rejectedById], references: [id])
  members        CommunityMember[]
  posts          Post[]
  events         CommunityEvent[]
  categories     CommunityCategory[]
  communityRoles CommunityRole[]

  @@index([slug])
  @@index([status])
  @@index([ownerId])
  @@index([category])
  @@index([deletedAt])
  @@map("communities")
}

model CommunityMember {
  id          String   @id @default(uuid()) @db.VarChar(36)
  communityId String   @map("community_id") @db.VarChar(36)
  userId      String   @map("user_id") @db.VarChar(36)
  role        String   @default("MEMBER") @db.VarChar(20)
  joinedAt    DateTime @default(now()) @map("joined_at")
  status      String   @default("ACTIVE") @db.VarChar(20)

  // Relations
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([communityId])
  @@index([userId])
  @@map("community_members")
}

model CommunityEvent {
  id          String @id @default(uuid()) @db.VarChar(36)
  communityId String @map("community_id") @db.VarChar(36)
  eventId     String @map("event_id") @db.VarChar(36)

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([communityId, eventId])
  @@map("community_events")
}

model CommunityCategory {
  id          String   @id @default(uuid()) @db.VarChar(36)
  communityId String   @map("community_id") @db.VarChar(36)
  categoryId  String   @map("category_id") @db.VarChar(36)
  createdAt   DateTime @default(now()) @map("created_at")

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([communityId, categoryId])
  @@map("community_categories")
}

model CommunityRole {
  id          String   @id @default(uuid()) @db.VarChar(36)
  communityId String   @map("community_id") @db.VarChar(36)
  name        String   @db.VarChar(50)
  description String?  @db.VarChar(255)
  permissions String?  @db.Text // JSON array of permission strings
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([communityId, name])
  @@map("community_roles")
}

// ============================================
// ORGANIZATION
// ============================================

model Organization {
  id              String    @id @default(uuid()) @db.VarChar(36)
  name            String    @db.VarChar(200)
  slug            String    @unique @db.VarChar(200)
  description     String    @db.Text
  shortDescription String?  @map("short_description") @db.VarChar(300)
  logo            String?   @db.VarChar(500)
  banner          String?   @db.VarChar(500)
  industry        String?   @db.VarChar(100)
  location        String?   @db.VarChar(200)
  website         String?   @db.VarChar(500)
  contactEmail    String?   @map("contact_email") @db.VarChar(255)
  foundedAt       DateTime? @map("founded_at")
  size            String?   @db.VarChar(50)
  status          String    @default("PENDING") @db.VarChar(20)
  statusReason    String?   @map("status_reason") @db.VarChar(500)
  approvedAt      DateTime? @map("approved_at")
  approvedById    String?   @map("approved_by_id") @db.VarChar(36)
  rejectedAt      DateTime? @map("rejected_at")
  rejectedById    String?   @map("rejected_by_id") @db.VarChar(36)
  suspendedAt     DateTime? @map("suspended_at")
  suspendedReason String?   @map("suspended_reason") @db.VarChar(500)
  ownerId         String    @map("owner_id") @db.VarChar(36)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  // Relations
  owner    User                 @relation("OrgOwner", fields: [ownerId], references: [id])
  approver User?                @relation("OrgApprover", fields: [approvedById], references: [id])
  members  OrganizationMember[]
  events   OrganizationEvent[]

  @@index([slug])
  @@index([status])
  @@index([ownerId])
  @@index([deletedAt])
  @@map("organizations")
}

model OrganizationMember {
  id             String   @id @default(uuid()) @db.VarChar(36)
  organizationId String   @map("organization_id") @db.VarChar(36)
  userId         String   @map("user_id") @db.VarChar(36)
  role           String   @default("MEMBER") @db.VarChar(20)
  joinedAt       DateTime @default(now()) @map("joined_at")
  status         String   @default("ACTIVE") @db.VarChar(20)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

model OrganizationEvent {
  id             String @id @default(uuid()) @db.VarChar(36)
  organizationId String @map("organization_id") @db.VarChar(36)
  eventId        String @map("event_id") @db.VarChar(36)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([organizationId, eventId])
  @@map("organization_events")
}

// ============================================
// EVENT
// ============================================

model Event {
  id                  String    @id @default(uuid()) @db.VarChar(36)
  title               String    @db.VarChar(200)
  slug                String    @unique @db.VarChar(200)
  description         String    @db.LongText
  shortDescription    String?   @map("short_description") @db.VarChar(300)
  banner              String?   @db.VarChar(500)
  startDate           DateTime  @map("start_date")
  endDate             DateTime  @map("end_date")
  startTime           String?   @map("start_time") @db.VarChar(10)
  endTime             String?   @map("end_time") @db.VarChar(10)
  location            String?   @db.VarChar(300)
  locationUrl         String?   @map("location_url") @db.VarChar(500)
  isOnline            Boolean   @default(false) @map("is_online")
  onlineUrl           String?   @map("online_url") @db.VarChar(500)
  category            String    @db.VarChar(100)
  capacity            Int?      @db.Int
  registrationDeadline DateTime? @map("registration_deadline")
  status              String    @default("DRAFT") @db.VarChar(20)
  statusReason        String?   @map("status_reason") @db.VarChar(500)
  approvedAt          DateTime? @map("approved_at")
  approvedById        String?   @map("approved_by_id") @db.VarChar(36)
  createdById         String    @map("created_by_id") @db.VarChar(36)
  isFeatured          Boolean   @default(false) @map("is_featured")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  // Relations
  creator       User               @relation("EventCreator", fields: [createdById], references: [id])
  approver      User?              @relation("EventApprover", fields: [approvedById], references: [id])
  registrations EventRegistration[]
  communities   CommunityEvent[]
  organizations OrganizationEvent[]

  @@index([slug])
  @@index([status])
  @@index([createdById])
  @@index([category])
  @@index([startDate])
  @@index([deletedAt])
  @@map("events")
}

model EventRegistration {
  id          String    @id @default(uuid()) @db.VarChar(36)
  eventId     String    @map("event_id") @db.VarChar(36)
  userId      String    @map("user_id") @db.VarChar(36)
  status      String    @default("REGISTERED") @db.VarChar(20)
  registeredAt DateTime @default(now()) @map("registered_at")
  cancelledAt DateTime? @map("cancelled_at")
  checkedInAt DateTime? @map("checked_in_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("event_registrations")
}

// ============================================
// CATEGORY
// ============================================

model Category {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(500)
  type        String   @db.VarChar(20) // COMMUNITY, EVENT, ORGANIZATION
  isActive    Boolean  @default(true) @map("is_active")
  parentId    String?  @map("parent_id") @db.VarChar(36)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  communityCategories CommunityCategory[]

  @@index([type])
  @@index([isActive])
  @@index([slug])
  @@map("categories")
}

// ============================================
// POST
// ============================================

model Post {
  id          String    @id @default(uuid()) @db.VarChar(36)
  communityId String    @map("community_id") @db.VarChar(36)
  authorId    String    @map("author_id") @db.VarChar(36)
  title       String    @db.VarChar(200)
  slug        String    @db.VarChar(250)
  content     String    @db.LongText
  excerpt     String?   @db.VarChar(500)
  coverImage  String?   @map("cover_image") @db.VarChar(500)
  status      String    @default("DRAFT") @db.VarChar(20)
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author    User      @relation("PostAuthor", fields: [authorId], references: [id])

  @@unique([communityId, slug])
  @@index([communityId])
  @@index([authorId])
  @@index([status])
  @@index([deletedAt])
  @@map("posts")
}

// ============================================
// REPORT
// ============================================

model Report {
  id          String    @id @default(uuid()) @db.VarChar(36)
  reporterId  String    @map("reporter_id") @db.VarChar(36)
  targetType  String    @map("target_type") @db.VarChar(20)
  targetId    String    @map("target_id") @db.VarChar(36)
  reason      String    @db.VarChar(200)
  description String?   @db.Text
  status      String    @default("PENDING") @db.VarChar(20)
  resolvedAt  DateTime? @map("resolved_at")
  resolvedById String?  @map("resolved_by_id") @db.VarChar(36)
  resolution  String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  reporter User @relation("ReportReporter", fields: [reporterId], references: [id])
  resolver User? @relation("ReportResolver", fields: [resolvedById], references: [id])

  @@index([status])
  @@index([targetType, targetId])
  @@index([reporterId])
  @@map("reports")
}

// ============================================
// NOTIFICATION
// ============================================

model Notification {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  type      String   @db.VarChar(20)
  title     String   @db.VarChar(200)
  message   String   @db.Text
  data      String?  @db.Text // JSON
  isRead    Boolean  @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================
// AUDIT LOG
// ============================================

model AuditLog {
  id         String  @id @default(uuid()) @db.VarChar(36)
  userId     String  @map("user_id") @db.VarChar(36)
  action     String  @db.VarChar(100)
  entityType String  @map("entity_type") @db.VarChar(50)
  entityId   String  @map("entity_id") @db.VarChar(36)
  oldValues  String? @map("old_values") @db.Text // JSON
  newValues  String? @map("new_values") @db.Text // JSON
  metadata   String? @db.Text // JSON
  ipAddress  String? @map("ip_address") @db.VarChar(45)
  userAgent  String? @map("user_agent") @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// MEDIA ASSETS
// ============================================

model MediaAsset {
  id               String   @id @default(uuid()) @db.VarChar(36)
  userId           String   @map("user_id") @db.VarChar(36)
  filename         String   @db.VarChar(255)
  originalFilename String   @map("original_filename") @db.VarChar(255)
  mimeType         String   @map("mime_type") @db.VarChar(100)
  size             Int      @db.Int
  url              String   @db.VarChar(1000)
  thumbnailUrl     String?  @map("thumbnail_url") @db.VarChar(1000)
  altText          String?  @map("alt_text") @db.VarChar(255)
  entityType       String?  @map("entity_type") @db.VarChar(50)
  entityId         String?  @map("entity_id") @db.VarChar(36)
  createdAt        DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entityType, entityId])
  @@map("media_assets")
}

// ============================================
// CONTACT MESSAGE
// ============================================

model ContactMessage {
  id        String   @id @default(uuid()) @db.VarChar(36)
  name      String   @db.VarChar(100)
  email     String   @db.VarChar(255)
  subject   String   @db.VarChar(200)
  message   String   @db.Text
  status    String   @default("UNREAD") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([status])
  @@map("contact_messages")
}

// ============================================
// SETTING
// ============================================

model Setting {
  id          String   @id @default(uuid()) @db.VarChar(36)
  key         String   @unique @db.VarChar(100)
  value       String   @db.Text
  description String?  @db.VarChar(500)
  updatedById String?  @map("updated_by_id") @db.VarChar(36)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([key])
  @@map("settings")
}
