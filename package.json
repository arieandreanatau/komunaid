{
  "name": "komunaid",
  "version": "0.1.0",
  "private": true,
  "description": "KomunaID - Platform Komunitas Digital Indonesia",
  "scripts": {
    "dev": "pnpm --filter @komunaid/api dev & pnpm --filter @komunaid/web dev",
    "dev:web": "pnpm --filter @komunaid/web dev",
    "dev:api": "pnpm --filter @komunaid/api dev",
    "build": "pnpm --filter @komunaid/api build && pnpm --filter @komunaid/web build",
    "build:web": "pnpm --filter @komunaid/web build",
    "build:api": "pnpm --filter @komunaid/api build",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "pnpm -r lint",
    "db:generate": "pnpm --filter @komunaid/database generate",
    "db:push": "pnpm --filter @komunaid/database push",
    "db:migrate": "pnpm --filter @komunaid/database migrate",
    "db:migrate:prod": "pnpm --filter @komunaid/database migrate:prod",
    "db:seed": "pnpm --filter @komunaid/database seed",
    "db:studio": "pnpm --filter @komunaid/database studio",
    "db:reset": "pnpm --filter @komunaid/database reset",
    "clean": "rm -rf node_modules && pnpm -r exec rm -rf node_modules"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
