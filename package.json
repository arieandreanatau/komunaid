{
  "name": "komunaid",
  "version": "0.1.0",
  "private": true,
  "description": "KomunaID - Platform Komunitas Digital Indonesia",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "pnpm db:generate && pnpm --filter @komunaid/api dev & pnpm --filter @komunaid/web dev",
    "dev:web": "pnpm db:generate && pnpm --filter @komunaid/web dev",
    "dev:api": "pnpm db:generate && pnpm --filter @komunaid/api dev",
    "build": "pnpm db:generate && pnpm --filter @komunaid/api build && pnpm --filter @komunaid/web build",
    "build:web": "pnpm db:generate && pnpm --filter @komunaid/web build",
    "build:api": "pnpm db:generate && pnpm --filter @komunaid/api build",
    "lint": "pnpm -r lint",
    "test:e2e": "pnpm --filter @komunaid/web test:e2e",
    "test:e2e:ui": "pnpm --filter @komunaid/web test:e2e:ui",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @komunaid/database generate",
    "db:push": "pnpm --filter @komunaid/database push",
    "db:migrate": "pnpm --filter @komunaid/database migrate",
    "db:migrate:prod": "pnpm --filter @komunaid/database migrate:prod",
    "db:seed": "pnpm --filter @komunaid/database seed",
    "db:studio": "pnpm --filter @komunaid/database studio",
    "db:reset": "pnpm --filter @komunaid/database reset",
    "clean": "rm -rf node_modules && pnpm -r exec rm -rf node_modules",
    "test": "pnpm --filter @komunaid/api test",
    "test:coverage": "pnpm --filter @komunaid/api test:coverage",
    "test:watch": "pnpm --filter @komunaid/api test:watch",
    "test:web": "pnpm --filter @komunaid/web test",
    "validate": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "security:audit": "pnpm audit --audit-level=high",
    "ci": "pnpm install --frozen-lockfile && pnpm validate"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=4.0.0 <5.0.9": "5.0.9",
      "@hono/node-server": "1.19.15",
      "ajv@^6.12.4": "6.12.6",
      "ajv@^8.0.0": "8.18.0",
      "esbuild@<0.25.0": "0.25.0",
      "hono": "4.12.34",
      "js-yaml@<4.3.1": "4.3.1",
      "nanoid": "3.3.18",
      "path-to-regexp@>=4.0.0 <6.3.0": "6.3.0",
      "postcss": "8.5.26",
      "sharp": "0.35.0",
      "tar": "7.5.21",
      "undici": "7.29.0"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
