{
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @komunaid/shared build && pnpm --filter @komunaid/database db:generate && pnpm --filter @komunaid/api build",
  "framework": null,
  "outputDirectory": ".",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": [
        "apps/api/src/**",
        "packages/shared/dist/**",
        "packages/shared/package.json",
        "packages/database/prisma/**",
        "packages/database/src/**",
        "packages/database/package.json",
        "node_modules/.prisma/**",
        "node_modules/@prisma/client/**"
      ]
    }
  }
}
