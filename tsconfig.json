{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "incremental": true,
    "paths": {
      "@komunaid/database": ["./packages/database/src"],
      "@komunaid/shared": ["./packages/shared/src"],
      "@komunaid/config": ["./packages/config"],
      "@komunaid/ui": ["./packages/ui/src"]
    }
  },
  "exclude": ["node_modules", "**/dist", "**/build", "**/.next"]
}
