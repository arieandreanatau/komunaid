{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "incremental": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@komunaid/shared": ["./packages/shared/src"],
      "@komunaid/shared/*": ["./packages/shared/src/*"],
      "@komunaid/database": ["./packages/database/src"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".next", "out"]
}
